---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryItem from '../../components/GalleryItem.astro';
import Lightbox from '../../components/Lightbox.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
	const albums = await getCollection('albums');
	return albums.map((album) => ({ params: { album: album.id }, props: { album } }));
}
const { album } = Astro.props as { album: CollectionEntry<'albums'> };

/*
 * The grid only ever shows a photo at ~302-640px wide, but the originals are
 * ~4000px, which is where the bulk of the 60MB build output came from. So each
 * photo gets two optimized variants at build time:
 *
 *   - the thumbnail, generated by <Image> in GalleryItem
 *   - `fullSrc` below, a 1600px version the lightbox swaps in on click.
 *
 * 1600px covers the lightbox's `max-height: 85vh` even on a 2x display.
 */
const THUMBNAIL_WIDTH = 1600;

const photos = await Promise.all(
	album.data.photos.map(async (photo) => ({
		image: photo,
		alt: album.data.title,
		fullSrc: (
			await getImage({ src: photo, width: THUMBNAIL_WIDTH, quality: 72 })
		).src,
	}))
);

const lightboxPhotos = photos.map((p) => ({ fullSrc: p.fullSrc, alt: p.alt }));
---

<BaseLayout
	title={`${album.data.title} | ${site.name}`}
	description={album.data.description}
>
	<section class="min-h-screen flex flex-col items-center pt-20 xl:pt-40 pb-8 px-4">
		<a href="/creative" class="text-textSecondary mb-6 hover:text-textPrimary">&larr; Creative</a>
		<h1 class="title text-3xl md:text-4xl lg:text-5xl text-center mb-4">{album.data.title}</h1>
		<p class="fashion-intro text-textSecondary text-center mb-8 max-w-md">
			{album.data.description}
		</p>
		<div class="fashion-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6 max-w-7xl w-full">
			{photos.map((photo, i) => (
				<GalleryItem image={photo.image} fullSrc={photo.fullSrc} alt={photo.alt} index={i} />
			))}
		</div>
	</section>

	<Lightbox photos={lightboxPhotos} />
</BaseLayout>
