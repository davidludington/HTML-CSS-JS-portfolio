---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpeg';
import { site, socials } from '../data/site';
import { icon } from '../data/icons';
import Icon from './Icon.astro';
---

<section
	id="profile"
	class="min-h-screen flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12 lg:gap-20 pt-20 xl:pt-40 pb-8 px-4 md:px-8 lg:px-40"
>
	<div
		class="section__pic-container w-64 h-64 md:w-80 md:h-80 lg:w-[400px] lg:h-[400px] flex-shrink-0"
	>
		{/*
			The headshot is the LCP element on every page that shows it, so it is
			eager and high priority rather than lazy. 713px is the source width, so
			that is the largest variant worth generating.
		*/}
		<Image
			src={headshot}
			alt={`${site.name} profile picture`}
			widths={[400, 713]}
			sizes="(min-width: 1024px) 400px, (min-width: 768px) 320px, 256px"
			loading="eager"
			fetchpriority="high"
			class="w-full h-full object-cover rounded-full border-4 border-border"
		/>
	</div>
	<div class="section__text text-center md:text-center">
		<p class="section__text__p1 text-textSecondary font-semibold mb-2">Hello, I'm</p>
		<h1 class="title text-4xl md:text-5xl lg:text-6xl text-textPrimary font-semibold mb-2">
			{site.name}
		</h1>
		<p class="section__text__p2 text-xl md:text-2xl text-textSecondary mb-6">{site.role}</p>
		<div class="btn-container flex flex-col sm:flex-row justify-center gap-4 mb-6">
			<a
				class="btn btn-color-2 px-6 py-3 min-w-[160px] flex items-center justify-center"
				href={site.resumeUrl}
			>
				Download CV
			</a>
			<a
				class="btn btn-color-1 px-6 py-3 min-w-[160px] flex items-center justify-center"
				href="/work#contact"
			>
				Contact Info
			</a>
		</div>
		<div id="socials-container" class="flex justify-center gap-4 mt-4">
			{
				socials.map((social) => (
					<a href={social.href}>
						<Icon
							image={icon(social.icon)}
							alt={social.label}
							class="icon w-8 h-8 md:w-10 md:h-10 cursor-pointer hover:scale-110 transition-transform"
						/>
					</a>
				))
			}
		</div>
	</div>
</section>
