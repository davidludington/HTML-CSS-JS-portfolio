---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = {
	project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;
const { title, image, github, demo } = project.data;
---

<div
	class="details-container color-container p-4 md:p-6 bg-card rounded-2xl border border-borderLight"
>
	<div class="article-container mb-4">
		<Image
			src={image}
			alt={title}
			widths={[480, 960]}
			sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
			loading="lazy"
			class="project-img w-full h-48 object-cover rounded-xl"
		/>
	</div>
	<h2 class="experience-sub-title project-title text-lg md:text-xl text-textPrimary mb-4">
		{title}
	</h2>
	<div class="btn-container flex flex-col sm:flex-row gap-3">
		<a
			href={github}
			target="_blank"
			rel="noopener noreferrer"
			class="btn btn-color-2 project-btn px-4 py-2 text-sm flex items-center justify-center"
		>
			Github
		</a>
		{
			demo && (
				<a
					href={demo}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-color-2 project-btn px-4 py-2 text-sm flex items-center justify-center"
				>
					Live Demo
				</a>
			)
		}
	</div>
</div>
